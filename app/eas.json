{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE": "http://localhost:4000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "buildConfiguration": "Release" },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE": "https://api.splithive.pritamrauniyar.com.np"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE": "https://api.splithive.pritamrauniyar.com.np"
      }
    },
    "simulator": {
      "ios": { "simulator": true },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE": "https://api.splithive.pritamrauniyar.com.np"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
