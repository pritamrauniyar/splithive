PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=splithive
JWT_SECRET=change_me_long_random

# Public URL of your API (for verification links)
# APP_PUBLIC_URL=http://your-domain-or-ip:4000

# SMTP configuration (enable to send real emails)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=SplitHive <no-reply@yourdomain.com>

# Verification throttle (optional overrides)
# VERIFY_RESEND_MIN_SEC=60
# VERIFY_MAX_PER_HOUR=5

# Password reset throttle (optional overrides)
# RESET_RESEND_MIN_SEC=60
# RESET_MAX_PER_HOUR=5
